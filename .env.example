HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
NODE_ENV=development
DATABASE_PATH=./data/vnl.sqlite
# Required on Vercel: use a Turso libSQL database. Never commit real tokens.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
ADMIN_PASSWORD=
# Keep disabled until the bank and SePay webhook are connected and tested.
PAYMENTS_MODE=disabled
BANK_CODE=970415
BANK_GATEWAY=VietinBank
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
# Secret configured in SePay webhook: HMAC-SHA256. Minimum 32 characters.
SEPAY_WEBHOOK_SECRET=
